# Copy the values from your Firebase project's Web app settings into .env.local.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Optional: emulator-only development mode. These values force all Auth/Firestore traffic to emulators.
# For browser preview use localhost/127.0.0.1; Android emulator uses 10.0.2.2.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
